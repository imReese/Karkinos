# Deny by default. Keep this allowlist aligned with Dockerfile COPY sources so
# secrets, private account evidence, databases, logs, reports, and tool state
# never enter the Docker build context.
**

!pyproject.toml
!uv.lock
!README.md
!LICENSE

!account_truth/
!account_truth/**/
!account_truth/**/*.py
!analytics/
!analytics/**/
!analytics/**/*.py
!backtest/
!backtest/**/
!backtest/**/*.py
!core/
!core/**/
!core/**/*.py
!data/
!data/**/
!data/**/*.py
!domain/
!domain/**/
!domain/**/*.py
!execution/
!execution/**/
!execution/**/*.py
!notification/
!notification/**/
!notification/**/*.py
!risk/
!risk/**/
!risk/**/*.py
!server/
!server/**/
!server/**/*.py
!strategy/
!strategy/**/
!strategy/**/*.py

!web/
!web/package.json
!web/package-lock.json
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/src/
!web/src/**/
!web/src/**/*.ts
!web/src/**/*.tsx
!web/src/**/*.css

# Runtime/generated files remain excluded even if they appear below an allowed
# source directory.
**/__pycache__/
**/*.py[cod]
**/.DS_Store
**/.env
**/.env.*
**/config.json
**/secret.py
**/broker_statement.csv
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.duckdb
**/logs/
**/reports/
**/exports/
**/screenshots/
data/store/
strategy/extensions/**
!strategy/extensions/__init__.py
web/node_modules/
web/dist/
