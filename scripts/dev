#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
PYTHON="${SCRIPT_DIR}/../.venv/bin/python"
if [ ! -x "${PYTHON}" ]; then
    echo "Install development dependencies: uv sync --locked --extra server --extra dev" >&2
    exit 1
fi
exec "${PYTHON}" "${SCRIPT_DIR}/service/run_dev.py" "$@"
